NODE_ENV=development
HOST=127.0.0.1
# Proxy local (Caddy/Nginx): loopback. Vazio desabilita confiança no proxy.
TRUST_PROXY=
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alocca
# Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES=900

# Filer privado; nunca publique esta URL para os clientes.
SEAWEEDFS_FILER_URL=http://127.0.0.1:8888

ADMIN_WEB_ORIGIN=http://localhost:5173

# Chave estável para cifrar a fila de e-mail (opcional; fallback: JWT_SECRET).
# Gere com: openssl rand -hex 32. Preserve enquanto houver mensagens pendentes.
EMAIL_OUTBOX_SECRET=

# Notificações de plantão por SMTP (opt-in do ambiente e do destinatário).
NOTIFICACOES_EMAIL_HABILITADO=false

# SMTP compartilhado com recuperação de senha (opcional)
# gmail: smtp.gmail.com, porta 465, SMTP_PASS = senha de app
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin inicial: criado apenas se este e-mail ainda não existir.
# Troque estas credenciais de exemplo antes de expor o backend a qualquer rede.
ADMIN_EMAIL=admin@alocca.local
ADMIN_PASSWORD=AloccaAdmin@2026
